# Wiring for the containers, loaded after .env so these two win.
#
# Everything else — credentials, model, context window, contact address — stays in .env
# and is shared. Only the addresses differ, and they differ for one reason: inside a
# container 127.0.0.1 is that container.

# The database is a sibling service on the compose network, not a published host port.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Laptop: Ollama runs natively on the host, where it reaches Metal and the host's full
# memory. Docker Desktop's VM offers neither, and a 9.6 GB model in there falls back to
# CPU — measured at 21.4 s/article against 4.3 s natively.
# Server: `docker compose --profile server up -d` runs Ollama as a container instead;
# change this to http://ollama:11434 there.
OLLAMA_HOST=http://host.docker.internal:11434
