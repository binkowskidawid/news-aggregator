# Matches the formatters rather than competing with them: ruff for Python, Prettier defaults
# for the front end. An editor that disagrees with `ruff format` produces a diff on every save.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,mjs,json,yml,yaml,css}]
indent_size = 2

[*.md]
# Trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
