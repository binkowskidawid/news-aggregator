# Local working notes and generated reports. `make audit-sources` and `make eval-report`
# write here, and their output is reproducible from the database rather than committed.
docs/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Env / secrets
.env
!.env.example

# Raw model responses from evaluation runs — large and reproducible.
eval/runs/

# OS / editor
.DS_Store
.idea/
.vscode/

# Per-machine agent settings: tool permissions and local paths, useful to nobody else.
# Listed here rather than left to a contributor's global ignore file, which is the only
# thing that was keeping it out of this repository.
.claude/settings.local.json

# Screenshots and snapshots left by the Playwright MCP browser
.playwright-mcp/
