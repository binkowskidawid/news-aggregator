# Copy to .env and fill in real values. Never commit .env.

# --- Postgres -----------------------------------------------------------------
# Also read directly by docker-compose.yml to configure the postgres service.
POSTGRES_USER=news
POSTGRES_PASSWORD=change-me
POSTGRES_DB=news
# Host-side port. Defaults away from 5432, which another local stack usually holds.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://news:change-me@127.0.0.1:5433/news

# --- LLM backends -------------------------------------------------------------
# Which provider the analyzer talks to: "ollama" or "openrouter".
LLM_PROVIDER=ollama

# Ollama runs NATIVELY on the host during local development, never in Docker:
# Docker Desktop on macOS caps the VM well below the host's memory and passes no
# GPU through, so larger quantisations neither fit nor reach Metal.
# On the deployment server, start the `server` compose profile and switch this to
# http://ollama:11434.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
# Must exceed the assembled prompt (~9,200 tokens) plus the 4096-token response
# ceiling. Below that llama.cpp slides the window and drops the system prompt's
# opening instructions without reporting anything.
OLLAMA_NUM_CTX=16384

# Cloud baseline. Used to quantify how much quality a local model gives up, and to
# test whether commercial providers decline to assess named political media.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Web application ----------------------------------------------------------
# Session cookies carry the Secure flag unless this is set to 0, so an installation
# served over plain HTTP has to say so rather than leaking sessions by omission.
# Set it to 0 ONLY for local development against http://localhost — with the default,
# a browser silently discards the cookie there and sign-in appears to do nothing.
COOKIE_SECURE=1

# Serve /docs, /redoc and /openapi.json. Off by default: the front end proxies every
# /api/* path verbatim, so leaving them on publishes an interactive console and a full
# route listing — including the operator paths that answer 404 in order not to confirm
# they exist. `make api-types` turns it on for its own run and does not need this.
API_DOCS=0

# --- Ingest -------------------------------------------------------------------
# Identifies this crawler to the portals we fetch from. A contactable address is
# part of behaving well towards the sites; do not leave the placeholder in place.
CONTACT_EMAIL=you@example.com

# crawl4ai is reachable only on the internal Docker network and requires this token.
CRAWL4AI_API_TOKEN=change-me
CRAWL4AI_URL=http://crawl4ai:11235
