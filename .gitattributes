# Line endings settled here rather than left to each contributor's core.autocrlf. Without
# this, a checkout on Windows and one on Linux disagree about every line of LICENSE and of
# the CSV fixtures, and the first pull request from either shows a diff of the whole file.
* text=auto eol=lf

# Binary, so never line-ending normalised.
#
# The reference sets under eval/ are deliberately not listed here, though an earlier version
# of this comment implied they were. They carry no offsets — eval/gold_labels.csv is
# slug/type/field/quote/note, and evals.gold resolves each quote to a span with locate_quote
# when the set is loaded. Normalising them to LF moves nothing, and marking them binary would
# cost a readable diff on the one kind of file most worth reviewing line by line.
*.png binary
*.jpg binary
*.ico binary

# Generated, and reviewed as a whole or not at all. Collapsed in pull request diffs.
uv.lock linguist-generated=true
web/pnpm-lock.yaml linguist-generated=true
web/lib/api-types.ts linguist-generated=true
